{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://129.225.88.110:8888/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "http://129.225.88.110:8888/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "http://129.225.88.110:8888/login/oauth2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
