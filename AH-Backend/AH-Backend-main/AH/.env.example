# Choose local, dev, or prod. Local is the default.
SPRING_PROFILES_ACTIVE=local
PORT=8888

# Local PostgreSQL supplied by compose.local.yml
DATABASE_URL=jdbc:postgresql://localhost:5432/anjaneya_herbals
DATABASE_USERNAME=anjaneya
DATABASE_PASSWORD=anjaneya_local_only

APP_FRONTEND_URL=http://localhost:5173
APP_OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Use a randomly generated value with at least 64 characters outside local use.
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters-long

# Local Ollama defaults. Pull these models after compose starts:
# docker compose -f compose.local.yml exec ollama ollama pull llama3.2
# docker compose -f compose.local.yml exec ollama ollama pull mxbai-embed-large
AI_CHAT_BASE_URL=http://localhost:11434
AI_CHAT_API_KEY=ollama
AI_CHAT_MODEL=llama3.2
AI_EMBEDDING_BASE_URL=http://localhost:11434
AI_EMBEDDING_API_KEY=ollama
AI_EMBEDDING_MODEL=mxbai-embed-large

# Required only for hosted AI or external services.
# GROQ_API_KEY=
# JINA_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
